{
  "rules": {
    ".read": false,
    ".write": false,
    "resultados": {
      ".read": "auth != null",
      ".indexOn": ["tentativas"],
      "$id": {
        ".write": "auth != null && !data.exists() && newData.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['id', 'uid', 'nickname', 'tentativas', 'numero', 'criadoEm'])",
        "id": { ".validate": "newData.isString() && newData.val() === $id" },
        "uid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "nickname": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
        "tentativas": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0" },
        "numero": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100 && newData.val() % 1 === 0" },
        "criadoEm": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "$other": { ".validate": false }
      }
    }
  }
}
